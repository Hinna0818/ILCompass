checkpoints/

# ---------- 目录级规则（保留 README / .gitkeep） ----------
/external/*
!/external/README.md

/data/*_RAW/
/data/raw/*
!/data/raw/README.md
/data/processed/*
!/data/processed/README.md
/data/prepared/*
!/data/prepared/README.md
/data/references/*
!/data/references/README.md

# model/ 下权重由上方扩展名规则排除；config、超参数、来源/hash、日志等小文件保留可提交
/model/**/checkpoint-*/

# ---------- results：只提交报告、小型汇总与图 ----------
/results/**/predictions/
/results/**/cell_embeddings*
/results/**/gene_embeddings*
/results/**/cell_metadata.tsv
# 可由 GTF 重新生成的全基因注释表
/results/**/ensembl_gene_annotation.tsv
/results/**/ensembl_biotype_core_genes.tsv
# 外部 API 原始响应（大、可由脚本重新抓取）
/results/tables/dataset_search/cxg_datasets.json

# ---------- 个人工作记录 ----------
/docs/task_plan.md
